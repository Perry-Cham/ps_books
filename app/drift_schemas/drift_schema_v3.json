    {
      "name": "collections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"collections\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"is_saved_collection\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_saved_collection\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"author\" TEXT NULL, \"path\" TEXT NOT NULL, \"cfi\" TEXT NULL, \"extension\" TEXT NOT NULL, \"page\" INTEGER NULL, \"progress\" REAL NOT NULL DEFAULT 0.0, \"collection\" INTEGER NULL REFERENCES collections (id), \"last_read\" INTEGER NOT NULL DEFAULT 0 CHECK (\"last_read\" IN (0, 1)), \"cover_path\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "timetables",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timetables\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"version\" INTEGER NOT NULL, \"last_modified\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "timetable_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timetable_days\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"timetable_id\" INTEGER NOT NULL REFERENCES timetables (id), \"day\" TEXT NOT NULL, \"is_break_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_break_day\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "timetable_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timetable_sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"day_id\" INTEGER NOT NULL REFERENCES timetable_days (id), \"start\" TEXT NOT NULL, \"end\" TEXT NOT NULL, \"subjects\" TEXT NOT NULL);"
        }
      ]
    },
